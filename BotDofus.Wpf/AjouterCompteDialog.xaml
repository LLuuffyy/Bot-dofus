<Window x:Class="BotDofus.Wpf.AjouterCompteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ajouter un compte" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}">
    <StackPanel Margin="24">
        <TextBox x:Name="TxtIdentifiant" materialDesign:HintAssist.Hint="Identifiant (alias local)" Margin="0,0,0,16"/>
        <TextBox x:Name="TxtLogin" materialDesign:HintAssist.Hint="Login Hystoria" Margin="0,0,0,16"/>
        <PasswordBox x:Name="TxtMdp" materialDesign:HintAssist.Hint="Mot de passe" Margin="0,0,0,16"/>
        <CheckBox x:Name="ChkPassif" Content="Mode passif (observer sans agir)" IsChecked="True" Margin="0,0,0,24"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="BtnAnnuler_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">Annuler</Button>
            <Button Click="BtnOk_Click" Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True">OK</Button>
        </StackPanel>
    </StackPanel>
</Window>
