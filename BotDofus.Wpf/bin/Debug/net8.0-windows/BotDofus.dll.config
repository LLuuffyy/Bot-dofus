<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Serveur privé Dofus Retro 1.29 (Hystoria) -->
    <!-- Auth + jeu sur deux IPs/ports distincts, observés via Synfus Bot -->
    <add key="ServeurAuth.Hote" value="162.19.127.156" />
    <add key="ServeurAuth.Port" value="450" />
    <add key="ServeurJeu.Hote" value="162.19.127.155" />
    <add key="ServeurJeu.Port" value="5555" />

    <!--
      Stratégie MITM Hystoria (cf. SynFus) :
      - On patche core.swf pour remplacer 162.19.127.156 par hystoria.local
      - On ajoute 127.0.0.1 hystoria.local au fichier hosts
      - Le client patché continue de se connecter sur le PORT D'ORIGINE (450)
      - Notre proxy auth doit donc écouter sur 450 (pas 5555)
      - Le proxy game se démarre dynamiquement après AYK sur 5556
    -->
    <add key="Proxy.PortAuthLocal" value="450" />
    <add key="Proxy.PortJeuLocal" value="5556" />

    <!-- Compat avec l'ancien nom de clef (utilisé par Options) -->
    <add key="Proxy.PortLocal" value="450" />

    <add key="Journalisation.Niveau" value="Info" />
    <add key="Journalisation.DossierSortie" value="logs" />
  </appSettings>
</configuration>
