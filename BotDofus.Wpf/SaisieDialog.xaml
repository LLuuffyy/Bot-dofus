<Window x:Class="BotDofus.Wpf.SaisieDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Saisie"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ShellBackgroundBrush}">
    <StackPanel Margin="22">
        <TextBlock x:Name="TxtMessage" Text="—" FontSize="13" Margin="0,0,0,12" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtSaisie"
                 Padding="6"
                 FontSize="14"
                 KeyDown="TxtSaisie_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler"
                    Click="BtnAnnuler_Click"
                    Style="{StaticResource TopNavButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="OK"
                    Click="BtnOk_Click"
                    IsDefault="True"
                    Background="#2E3156"
                    Foreground="#C9CEFF"
                    BorderBrush="#444D9F"
                    BorderThickness="1"
                    Style="{StaticResource TopNavButtonStyle}"/>
        </StackPanel>
    </StackPanel>
</Window>
