<UserControl x:Class="BotDofus.Wpf.Vues.VueBanque"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  Padding="16">
        <StackPanel>

            <!-- ========== HEADER ========== -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🏦 Banque automatique" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Quand le poids du perso atteint le seuil, le bot interrompt le farm, zaap à la banque, dépose les items selon les filtres, puis reprend le trajet. Protocole confirmé sur Hystoria (ApS / EMO+ / EV)."/>
                    <Separator Margin="0,8"/>
                    <CheckBox x:Name="ChkActive" Content="Activer le dépôt banque automatique" Margin="0,0,0,4"
                              Checked="ChkActive_Changed" Unchecked="ChkActive_Changed"/>
                    <TextBlock x:Name="TxtEtatLive" Foreground="#FFFFA000" FontSize="12" Margin="0,4,0,0" Text=""/>
                </StackPanel>
            </materialDesign:Card>

            <!-- ========== DÉCLENCHEMENT ========== -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📊 Déclenchement" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <DockPanel Margin="0,4">
                        <TextBlock Text="Seuil de poids (%) :" Width="220" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSeuil" Width="40" Text="80" VerticalAlignment="Center"/>
                        <Slider x:Name="SldSeuil" Minimum="20" Maximum="99" Value="80"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="SldSeuil_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="0,4">
                        <TextBlock Text="Cible après dépôt (%) :" Width="220" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCible" Width="40" Text="30" VerticalAlignment="Center"/>
                        <Slider x:Name="SldCible" Minimum="0" Maximum="80" Value="30"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="SldCible_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="Map banque (ID) :" Width="220" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtMapBanque" Width="100" Text="10306"
                                 TextChanged="TxtMapBanque_Changed"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                                   Text="(Astrub banque = 10306 sur Hystoria — capture user 16:52)"/>
                    </DockPanel>

                    <CheckBox x:Name="ChkOuvertureDirecte"
                              Content="Ouverture directe (skip zaap — perso doit être devant le coffre)"
                              Margin="0,8,0,0"
                              ToolTip="Si coché, le bot envoie ApS directement depuis la position actuelle sans tenter de zaap. À utiliser quand tu positionnes le perso manuellement avant le test."
                              Checked="ChkOuvertureDirecte_Changed" Unchecked="ChkOuvertureDirecte_Changed"/>

                    <CheckBox x:Name="ChkRetourFarm" Content="Retour automatique à la map de farm après dépôt"
                              Margin="0,4,0,0"
                              Checked="ChkRetourFarm_Changed" Unchecked="ChkRetourFarm_Changed"/>

                    <DockPanel Margin="0,8">
                        <TextBlock Text="Délai entre actions (ms) :" Width="220" VerticalAlignment="Center"/>
                        <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtDelaiMin" Width="60" Text="1500" TextChanged="TxtDelai_Changed"/>
                        <TextBlock Text=" max" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox x:Name="TxtDelaiMax" Width="60" Text="3000" TextChanged="TxtDelai_Changed"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                                   Text="(capture user manuelle : 1.3-3.9s, humain)"/>
                    </DockPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- ========== FILTRES CATÉGORIES ========== -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🎯 Filtres par catégorie" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Margin="0,0,0,12" Opacity="0.7" TextWrapping="Wrap"
                               Text="Items déposés UNIQUEMENT si la catégorie est cochée. Par défaut : seules les ressources sont déposées (récolte). Les autres restent en inventaire (sécurité)."/>

                    <CheckBox x:Name="ChkRessources" Content="📦 Ressources (blé, bois, lin, peaux, minerais, plantes…)"
                              Margin="0,2" Checked="ChkCategorie_Changed" Unchecked="ChkCategorie_Changed"/>
                    <CheckBox x:Name="ChkConsommables" Content="🥖 Consommables (pains, potions, parchemins)"
                              Margin="0,2" Checked="ChkCategorie_Changed" Unchecked="ChkCategorie_Changed"/>
                    <CheckBox x:Name="ChkEquipements" Content="⚔ Équipements (armes, armures, anneaux, capes, coiffes…)"
                              Margin="0,2" Checked="ChkCategorie_Changed" Unchecked="ChkCategorie_Changed"/>
                    <CheckBox x:Name="ChkQuetes" Content="📜 Items de quête (déconseillé — généralement on garde)"
                              Margin="0,2" Checked="ChkCategorie_Changed" Unchecked="ChkCategorie_Changed"/>
                    <CheckBox x:Name="ChkInconnus" Content="❓ Catégorie inconnue (type non répertorié)"
                              Margin="0,2" Checked="ChkCategorie_Changed" Unchecked="ChkCategorie_Changed"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- ========== LISTE BLANCHE / NOIRE ========== -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📋 Liste blanche / Liste noire (par template ID)" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Margin="0,0,0,12" Opacity="0.7" TextWrapping="Wrap"
                               Text="Liste noire = items GARDÉS même si la catégorie est cochée (pierres d'âme, items précieux). Liste blanche = items DÉPOSÉS même si la catégorie est décochée."/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🚫 LISTE NOIRE (toujours garder)" FontWeight="SemiBold" Foreground="#FFEF5350" Margin="0,0,0,4"/>
                            <TextBlock Opacity="0.6" FontSize="11" Margin="0,0,0,4"
                                       Text="IDs templates séparés par virgule ou retour ligne."/>
                            <TextBox x:Name="TxtIdsGarder" Height="120"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="TxtIdsGarder_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="✅ LISTE BLANCHE (toujours déposer)" FontWeight="SemiBold" Foreground="#FF66BB6A" Margin="0,0,0,4"/>
                            <TextBlock Opacity="0.6" FontSize="11" Margin="0,0,0,4"
                                       Text="IDs templates forcés à déposer (même hors catégorie)."/>
                            <TextBox x:Name="TxtIdsDeposer" Height="120"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="TxtIdsDeposer_Changed"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- ========== SEUILS PAR ITEM ========== -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🎚 Seuils par template (garder N exemplaires)" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Margin="0,0,0,12" Opacity="0.7" TextWrapping="Wrap"
                               Text="Format : `&lt;templateId&gt;=&lt;quantité à garder&gt;` sur chaque ligne. Ex : `312=50` pour garder 50 pains d'Astrub. Le surplus est déposé."/>

                    <TextBox x:Name="TxtSeuils" Height="100"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             TextChanged="TxtSeuils_Changed"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- ========== ACTIONS ========== -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🚀 Actions" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnSauver" Content="💾 Sauvegarder la config"
                                Padding="14,6" Margin="0,0,8,0" Click="BtnSauver_Click"/>
                        <Button x:Name="BtnRecharger" Content="🔄 Recharger depuis disque"
                                Padding="14,6" Margin="0,0,8,0" Click="BtnRecharger_Click"/>
                        <Button x:Name="BtnTester" Content="▶ Tester maintenant"
                                Padding="14,6" Margin="0,0,8,0" Click="BtnTester_Click"
                                ToolTip="Lance le workflow banque dès maintenant, peu importe le seuil."/>
                    </StackPanel>
                    <TextBlock x:Name="TxtEtatSauvegarde" Margin="0,8,0,0" FontSize="11" Foreground="#FF66BB6A" Text=""/>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
