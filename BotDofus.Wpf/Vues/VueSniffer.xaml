<UserControl x:Class="BotDofus.Wpf.Vues.VueSniffer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorderStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBox x:Name="TxtFiltre"
                             Width="210"
                             TextChanged="TxtFiltre_TextChanged"
                             Margin="0,0,10,0"
                             materialDesign:HintAssist.Hint="Prefixe (GA, GM, Ow)"/>
                    <ComboBox x:Name="CmbDirection"
                              Width="120"
                              SelectionChanged="CmbDirection_SelectionChanged">
                        <ComboBoxItem Content="Tous" IsSelected="True"/>
                        <ComboBoxItem Content="C->S"/>
                        <ComboBoxItem Content="S->C"/>
                    </ComboBox>
                    <CheckBox x:Name="ChkPings"
                              Content="Pings (CK/CP)"
                              IsChecked="False"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              Checked="ChkPings_Toggled"
                              Unchecked="ChkPings_Toggled"
                              ToolTip="Affiche les keep-alives CK/CP (très bavards)"/>
                    <CheckBox x:Name="ChkAutoScroll"
                              Content="Auto-scroll"
                              IsChecked="True"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"/>
                    <ToggleButton x:Name="BtnPause"
                                  Content="Pause"
                                  Margin="14,0,0,0"
                                  Padding="10,4"
                                  Click="BtnPause_Click"
                                  VerticalAlignment="Center"
                                  ToolTip="Met en pause la capture (les paquets continuent d'arriver mais ne sont plus affichés)"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtCount"
                               Text="0 paquets"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,12,0"/>
                    <Button Click="BtnClear_Click"
                            Style="{StaticResource TopNavButtonStyle}"
                            Content="Vider"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PanelBorderStyle}"
                Padding="0">
            <DataGrid x:Name="GridPaquets"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserSortColumns="False"
                      EnableRowVirtualization="False"
                      EnableColumnVirtualization="False"
                      GridLinesVisibility="Horizontal"
                      RowHeight="28"
                      FontFamily="Consolas"
                      FontSize="12"
                      Background="Transparent"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      SelectionUnit="CellOrRowHeader"
                      ClipboardCopyMode="IncludeHeader"
                      SelectionChanged="GridPaquets_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Heure" Binding="{Binding Heure}" Width="100"/>
                    <DataGridTextColumn Header="Sens" Binding="{Binding Sens}" Width="64">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sens}" Value="S->C">
                                        <Setter Property="Foreground" Value="#5BC8FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Sens}" Value="C->S">
                                        <Setter Property="Foreground" Value="#FFB347"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Prefixe" Binding="{Binding Prefixe}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Taille" Binding="{Binding Taille}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Charge" Binding="{Binding Charge}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource PanelBorderStyle}"
                Padding="12"
                Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Détail paquet sélectionné"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right"
                            Click="BtnCopierDetail_Click"
                            Style="{StaticResource TopNavButtonStyle}"
                            Content="Copier"/>
                </DockPanel>
                <TextBox Grid.Row="1"
                         x:Name="TxtDetail"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="160"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Text="(sélectionne une ligne ci-dessus pour voir le contenu complet)"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
