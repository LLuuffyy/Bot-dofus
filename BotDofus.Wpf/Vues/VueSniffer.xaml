<UserControl x:Class="BotDofus.Wpf.Vues.VueSniffer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorderStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBox x:Name="TxtFiltre"
                             Width="210"
                             TextChanged="TxtFiltre_TextChanged"
                             Margin="0,0,10,0"
                             materialDesign:HintAssist.Hint="Prefixe (GA, GM, Ow)"/>
                    <ComboBox x:Name="CmbDirection"
                              Width="120"
                              SelectionChanged="CmbDirection_SelectionChanged">
                        <ComboBoxItem Content="Tous" IsSelected="True"/>
                        <ComboBoxItem Content="C->S"/>
                        <ComboBoxItem Content="S->C"/>
                    </ComboBox>
                    <CheckBox x:Name="ChkAutoScroll"
                              Content="Auto-scroll"
                              IsChecked="True"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtCount"
                               Text="0 paquets"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,12,0"/>
                    <Button Click="BtnClear_Click"
                            Style="{StaticResource TopNavButtonStyle}"
                            Content="Vider"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PanelBorderStyle}"
                Padding="0">
            <DataGrid x:Name="GridPaquets"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserSortColumns="False"
                      GridLinesVisibility="Horizontal"
                      RowHeight="28"
                      FontFamily="Consolas"
                      FontSize="12"
                      Background="Transparent"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Heure" Binding="{Binding Heure}" Width="100"/>
                    <DataGridTextColumn Header="Sens" Binding="{Binding Sens}" Width="64"/>
                    <DataGridTextColumn Header="Prefixe" Binding="{Binding Prefixe}" Width="80"/>
                    <DataGridTextColumn Header="Charge" Binding="{Binding Charge}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
