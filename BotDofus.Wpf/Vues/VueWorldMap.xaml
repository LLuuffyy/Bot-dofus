<UserControl x:Class="BotDofus.Wpf.Vues.VueWorldMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="10" Margin="0,0,0,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="MapViewer"
                               Style="{StaticResource SectionTitleTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkGrille"
                              Content="Grille"
                              IsChecked="True"
                              Checked="Options_Changed"
                              Unchecked="Options_Changed"
                              Margin="0,0,12,0"/>
                    <CheckBox x:Name="ChkCoords"
                              Content="Coordonnees"
                              Checked="Options_Changed"
                              Unchecked="Options_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Click="BtnCentrerPerso_Click"
                            Style="{StaticResource TopNavButtonStyle}"
                            ToolTip="Recentre la worldmap sur la position courante du perso"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Centrer perso"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text=".travel" VerticalAlignment="Center" FontFamily="Consolas" Opacity="0.75" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtX" Width="56" Margin="0,0,4,0" materialDesign:HintAssist.Hint="x"/>
                    <TextBox x:Name="TxtY" Width="56" Margin="0,0,8,0" materialDesign:HintAssist.Hint="y"/>
                    <Button Click="BtnTravel_Click" Style="{StaticResource AccentNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MapMarkerPath" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Travel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#202228" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="Scroller"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#202228">
                    <Canvas x:Name="CanvasWorld"
                            Background="#777777"
                            MouseWheel="CanvasWorld_MouseWheel"/>
                </ScrollViewer>

                <Border x:Name="MenuContextuel"
                        Background="#EE2C3038"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <StackPanel MinWidth="230">
                        <TextBlock x:Name="TxtMenuCoords" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Button Click="BtnMenuTravel_Click" Style="{StaticResource AccentNavButtonStyle}" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerPath" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Deplacer vers cette map"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnMenuCopier_Click" Style="{StaticResource TopNavButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Copier .travel"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Background="#CC20242B"
                        CornerRadius="8"
                        Padding="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="12">
                    <TextBlock x:Name="TxtStatut"
                               Text="Worldmap non chargee"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Consolas"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
