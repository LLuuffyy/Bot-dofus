<UserControl x:Class="BotDofus.Wpf.Vues.VueCombat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer Padding="16">
        <StackPanel>

            <!-- ===== SORTS CONFIGURÉS ===== -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="⚔ SORTS CONFIGURÉS" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource SecondaryHueMidBrush}" VerticalAlignment="Center"/>
                        <Button Click="BtnViderTout_Click" DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Right">
                            Vider tout
                        </Button>
                    </DockPanel>

                    <!-- Liste des sorts configurés (style MoonBot) -->
                    <ItemsControl x:Name="ListeSortsConfig" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1F1F1F" CornerRadius="6" Padding="12,8" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- N° priorité -->
                                        <TextBlock Grid.Column="0" Text="{Binding Numero}" FontWeight="Bold" FontSize="14"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryHueMidBrush}"/>

                                        <!-- Pastille couleur sort -->
                                        <Ellipse Grid.Column="1" Width="24" Height="24" Fill="{Binding CouleurBrush}"
                                                 VerticalAlignment="Center"/>

                                        <!-- Nom du sort -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding NomSort}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding InfoSort}" FontSize="10" Opacity="0.6"/>
                                        </StackPanel>

                                        <!-- Cible -->
                                        <TextBlock Grid.Column="3" Text="{Binding CibleTexte}" VerticalAlignment="Center" FontSize="12" Opacity="0.85"/>

                                        <!-- Conditions résumées -->
                                        <TextBlock Grid.Column="4" Text="{Binding ConditionsTexte}" VerticalAlignment="Center" FontSize="11" Opacity="0.6"/>

                                        <!-- Boutons actions -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Click="BtnMonter_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="ArrowUp"/>
                                            </Button>
                                            <Button Click="BtnDescendre_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="ArrowDown"/>
                                            </Button>
                                            <Button Click="BtnSupprimer_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#E53935"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

            <!-- ===== AJOUTER UN SORT (filtré sur sorts appris) ===== -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="➕ AJOUTER UN SORT" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- SORT (dropdown filtré sur les sorts appris) -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="SORT" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbSort" SelectionChanged="CmbSort_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="16" Height="16" Fill="{Binding CouleurBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Affichage}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- CIBLE -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="CIBLE" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbCible" SelectedIndex="0">
                                <ComboBoxItem Content="Ennemi le plus proche"/>
                                <ComboBoxItem Content="Ennemi le plus faible"/>
                                <ComboBoxItem Content="Ennemi le plus fort"/>
                                <ComboBoxItem Content="Soi"/>
                                <ComboBoxItem Content="Allié le plus blessé"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- X FOIS / TOUR + X FOIS / CIBLE -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="X FOIS/TOUR" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtFoisTour" Text="1" materialDesign:HintAssist.Hint="0 = max"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="X FOIS/CIBLE" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtFoisCible" Text="0" materialDesign:HintAssist.Hint="0 = max"/>
                        </StackPanel>

                        <!-- Priorité -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="PRIORITÉ" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPriorite" Text="5"/>
                        </StackPanel>
                    </Grid>

                    <Button Click="BtnAjouter_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus"/>
                            <TextBlock Text=" Ajouter à la rotation" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- ===== TACTIQUE GLOBALE ===== -->
            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🧭 TACTIQUE GLOBALE" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="STRATÉGIE" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbStrategie" SelectionChanged="CmbStrategie_SelectionChanged">
                                <ComboBoxItem Content="Agressif"/>
                                <ComboBoxItem Content="Tactique"/>
                                <ComboBoxItem Content="Defensif"/>
                                <ComboBoxItem Content="Soutien"/>
                                <ComboBoxItem Content="Passif"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Button Click="BtnSauver_Click" Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"/>
                            <TextBlock Text=" Sauvegarder" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- ===== SORTS APPRIS DU PERSO ===== -->
            <materialDesign:Card Padding="16">
                <StackPanel>
                    <TextBlock x:Name="TxtSortsAppris" Text="📚 SORTS APPRIS (0)" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ListeSortsAppris">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1F1F1F" CornerRadius="6" Padding="8,4" Margin="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="14" Height="14" Fill="{Binding CouleurBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Affichage}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
