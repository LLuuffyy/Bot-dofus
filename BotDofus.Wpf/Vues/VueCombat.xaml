<UserControl x:Class="BotDofus.Wpf.Vues.VueCombat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="GhostIconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceBrushAlt}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="SORTS CONFIGURES"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Button Click="BtnViderTout_Click"
                                DockPanel.Dock="Right"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Foreground="{DynamicResource MutedTextBrush}"
                                Padding="4,0"
                                Cursor="Hand"
                                Content="Vider tout"/>
                    </DockPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Sort" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Cible" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Infos" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Conditions" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold"/>
                    </Grid>

                    <ItemsControl x:Name="ListeSortsConfig">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrushAlt}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="6"
                                                Background="{DynamicResource AccentBrushSoft}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Numero}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="16" Height="16" Fill="{Binding CouleurBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding NomSort}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CibleTexte}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding InfoSort}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ConditionsTexte}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource FaintTextBrush}"/>

                                        <StackPanel Grid.Column="5"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Click="BtnMonter_Click" Tag="{Binding}" Style="{StaticResource GhostIconButtonStyle}">
                                                <materialDesign:PackIcon Kind="ArrowUp" Width="16" Height="16"/>
                                            </Button>
                                            <Button Click="BtnDescendre_Click" Tag="{Binding}" Style="{StaticResource GhostIconButtonStyle}">
                                                <materialDesign:PackIcon Kind="ArrowDown" Width="16" Height="16"/>
                                            </Button>
                                            <Button Click="BtnSupprimer_Click" Tag="{Binding}" Style="{StaticResource GhostIconButtonStyle}" Foreground="{DynamicResource DangerBrush}">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="AJOUTER UN SORT"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="SORT" Style="{StaticResource SectionLabelStyle}"/>
                            <ComboBox x:Name="CmbSort" SelectionChanged="CmbSort_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="{Binding CouleurBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Affichage}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="CIBLE" Style="{StaticResource SectionLabelStyle}"/>
                            <ComboBox x:Name="CmbCible" SelectedIndex="0">
                                <ComboBoxItem Content="Ennemi le plus proche"/>
                                <ComboBoxItem Content="Ennemi le plus faible"/>
                                <ComboBoxItem Content="Ennemi le plus fort"/>
                                <ComboBoxItem Content="Soi"/>
                                <ComboBoxItem Content="Allie le plus blesse"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="X FOIS / TOUR" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBox x:Name="TxtFoisTour" Text="1" materialDesign:HintAssist.Hint="0 = max"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="X FOIS / CIBLE" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBox x:Name="TxtFoisCible" Text="0" materialDesign:HintAssist.Hint="0 = max"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="PRIORITE" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBox x:Name="TxtPriorite" Text="5"/>
                        </StackPanel>
                    </Grid>

                    <Button Click="BtnAjouter_Click"
                            Style="{StaticResource AccentNavButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0"
                            Content="Ajouter a la rotation"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="TACTIQUE GLOBALE"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="STRATEGIE" Style="{StaticResource SectionLabelStyle}"/>
                            <ComboBox x:Name="CmbStrategie" SelectionChanged="CmbStrategie_SelectionChanged">
                                <ComboBoxItem Content="Agressif"/>
                                <ComboBoxItem Content="Tactique"/>
                                <ComboBoxItem Content="Defensif"/>
                                <ComboBoxItem Content="Soutien"/>
                                <ComboBoxItem Content="Passif"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SAUVEGARDE" Style="{StaticResource SectionLabelStyle}"/>
                            <Button Click="BtnSauver_Click"
                                    Style="{StaticResource TopNavButtonStyle}"
                                    Content="Sauvegarder la config"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}" Margin="0">
                <StackPanel>
                    <TextBlock x:Name="TxtSortsAppris"
                               Text="SORTS APPRIS (0)"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14"/>

                    <ItemsControl x:Name="ListeSortsAppris">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrushAlt}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="8,6"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding CouleurBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Affichage}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
