<Window x:Class="BotDofus.Wpf.Vues.FenetreCopierConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copier la config combat vers..."
        Width="420"
        Height="480"
        Background="#1A1F2C"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TxtSource"
                   Text="Source : —"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#ECEFF5"
                   Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1"
                   Text="Coche les persos cibles. La config (mode, distances, sliders, rotation, conditions) sera intégralement copiée sur chacun."
                   FontSize="11"
                   Foreground="#9AB8E0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="2"
                Background="#23293A"
                BorderBrush="#3C4458"
                BorderThickness="1"
                CornerRadius="3"
                Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ListeCibles">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="2,4"
                                      IsChecked="{Binding Selectionne, Mode=TwoWay}"
                                      Foreground="#ECEFF5"
                                      VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="22" Height="22" Margin="6,0,8,0">
                                        <Ellipse Fill="{Binding CouleurClasse}"/>
                                        <TextBlock Text="{Binding Initiale}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#101418"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" Foreground="#ECEFF5"/>
                                        <TextBlock Text="{Binding SousTitre}" FontSize="10" Foreground="#8AA0BC"/>
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnToutCocher"
                    Content="Tout cocher"
                    Padding="10,4"
                    Background="#2D3548"
                    Foreground="#E0E5F0"
                    BorderThickness="0"
                    Click="BtnToutCocher_Click"
                    Margin="0,0,6,0"/>
            <Button x:Name="BtnAnnuler"
                    Content="Annuler"
                    Padding="10,4"
                    Background="#3D4453"
                    Foreground="#E0E5F0"
                    BorderThickness="0"
                    Click="BtnAnnuler_Click"
                    Margin="0,0,6,0"/>
            <Button x:Name="BtnCopier"
                    Content="Copier"
                    Padding="14,4"
                    Background="#3D5580"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="BtnCopier_Click"/>
        </StackPanel>
    </Grid>
</Window>
