<Window x:Class="BotDofus.Wpf.Vues.FenetreRoadCreator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Road Creator" Width="340" SizeToContent="Height"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="10" Background="#FF20242B" BorderBrush="#FF3A4452"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="0">
            <!-- Bandeau titre -->
            <Border CornerRadius="10,10,0,0" Background="#FF2B3340" Padding="14,10">
                <DockPanel>
                    <TextBlock Text="🛣" FontSize="16" DockPanel.Dock="Left"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnFermer" Content="✕" DockPanel.Dock="Right"
                            Width="24" Height="24" Background="Transparent"
                            Foreground="#FF9AA4B2" BorderThickness="0"
                            Click="BtnFermer_Click" Cursor="Hand"/>
                    <StackPanel>
                        <TextBlock Text="ROAD CREATOR" Foreground="#FF6FB7FF"
                                   FontWeight="Bold" FontSize="11" Opacity="0.8"/>
                        <TextBlock x:Name="TxtTitre" Text="Map [?,?] — ID: ?"
                                   Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="16,12,16,16">
                <TextBlock x:Name="TxtCompteur" Text="● REC — 0 waypoint"
                           Foreground="#FFE0606A" FontWeight="Bold" FontSize="12"
                           Margin="0,0,0,10"/>

                <Border Background="#FF272D36" CornerRadius="6" Padding="10,8">
                    <StackPanel>
                        <CheckBox x:Name="ChkCombat" Content="⚔  Combat sur cette map"
                                  Foreground="White" Margin="0,3" FontSize="13"/>
                        <CheckBox x:Name="ChkRecolte" Content="🌿  Récolte sur cette map"
                                  Foreground="White" Margin="0,3" FontSize="13"/>
                        <CheckBox x:Name="ChkDonjon" Content="🏰  Mode donjon"
                                  Foreground="#FFD8B673" Margin="0,3" FontSize="13"/>
                        <CheckBox x:Name="ChkBoss" Content="👑  C'est le boss (dernière salle)"
                                  Foreground="#FFD8B673" Margin="0,3" FontSize="13"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Cellule de sortie (optionnel — PAS pour changer de map)"
                           Foreground="#FF8C95A3" Margin="2,12,0,3" FontSize="11"
                           TextWrapping="Wrap"/>
                <TextBlock Text="↳ se déplacer sur cette case (récolte/PNJ). Pour CHANGER de carte, utilise une direction ci-dessous."
                           Foreground="#FF6F7B8A" Margin="2,0,0,3" FontSize="10"
                           TextWrapping="Wrap" FontStyle="Italic"/>
                <TextBox x:Name="TxtCellule" Background="#FF2A313B" Foreground="White"
                         BorderBrush="#FF3A4452" Padding="6,4"/>

                <TextBlock Text="PNJ sur la carte" Foreground="#FF8C95A3"
                           Margin="2,12,0,3" FontSize="11"/>
                <DockPanel>
                    <Button x:Name="BtnParlerPnj" Content="💬 Parler" DockPanel.Dock="Right"
                            Margin="6,0,0,0" Padding="8,4" Click="BtnParlerPnj_Click"
                            Background="#FF34618C" Foreground="White" BorderThickness="0"
                            Cursor="Hand"/>
                    <ComboBox x:Name="CmbPnj" Padding="6,4"
                              Background="#FFEDF1F6" Foreground="#FF15202B"
                              FontWeight="SemiBold"/>
                </DockPanel>
                <!-- Dialogue en direct : question + réponses cliquables -->
                <Border x:Name="BoxDialogue" Background="#FF1A2733" CornerRadius="6"
                        Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtDlgQuestion" Foreground="#FFD8E4F0"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"/>
                        <StackPanel x:Name="DlgReponses"/>
                        <TextBlock x:Name="TxtDlgEnregistre" Foreground="#FF8FE0A6"
                                   FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <TextBox x:Name="TxtAnswers" Visibility="Collapsed"/>

                <TextBlock Text="Direction de sortie" Foreground="#FF8C95A3"
                           Margin="2,14,0,6" FontSize="11"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="1" Content="↑ TOP" Margin="3"
                            Padding="8,6" Click="Dir_Click" Tag="top"
                            Background="#FF34618C" Foreground="White" BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Grid.Row="1" Grid.Column="0" Content="← LEFT" Margin="3"
                            Padding="8,6" Click="Dir_Click" Tag="left"
                            Background="#FF34618C" Foreground="White" BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="RIGHT →" Margin="3"
                            Padding="8,6" Click="Dir_Click" Tag="right"
                            Background="#FF34618C" Foreground="White" BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="↓ BOTTOM" Margin="3"
                            Padding="8,6" Click="Dir_Click" Tag="bottom"
                            Background="#FF34618C" Foreground="White" BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>

                <Button x:Name="BtnSansDir" Content="✓  Valider sans direction"
                        Margin="0,12,0,0" Padding="8,8" Click="Dir_Click" Tag=""
                        Background="#FF2D4A33" Foreground="#FF8FE0A6"
                        BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
