<Window x:Class="BotDofus.Wpf.Vues.FenetreRoadCreator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoadCreator" Width="320" SizeToContent="Height"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Background="#FF1E1E1E">
    <Border Padding="14" Background="#FF1E1E1E">
        <StackPanel>
            <TextBlock x:Name="TxtTitre" Text="Map [?,?] — ID: ?"
                       Foreground="#FF50B4DC" FontWeight="Bold" FontSize="14"
                       Margin="0,0,0,10"/>
            <CheckBox x:Name="ChkCombat" Content="⚔ Combat sur cette map"
                      Foreground="White" Margin="0,3"/>
            <CheckBox x:Name="ChkRecolte" Content="🌿 Récolte sur cette map"
                      Foreground="White" Margin="0,3"/>

            <TextBlock Text="Cellule de sortie (optionnel) :" Foreground="#FFB0B0B0"
                       Margin="0,10,0,2" FontSize="11"/>
            <TextBox x:Name="TxtCellule" Background="#FF2A2A2A" Foreground="White"
                     BorderBrush="#FF555555"/>

            <TextBlock Text="PNJ (optionnel) — id puis réponses (ex: -1,-1) :"
                       Foreground="#FFB0B0B0" Margin="0,10,0,2" FontSize="11"/>
            <DockPanel>
                <TextBox x:Name="TxtNpc" Width="70" DockPanel.Dock="Left"
                         Background="#FF2A2A2A" Foreground="White" BorderBrush="#FF555555"/>
                <TextBox x:Name="TxtAnswers" Margin="6,0,0,0"
                         Background="#FF2A2A2A" Foreground="White" BorderBrush="#FF555555"/>
            </DockPanel>

            <TextBlock Text="Direction de sortie :" Foreground="#FFB0B0B0"
                       Margin="0,12,0,4" FontSize="11"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="1" Content="↑ TOP" Margin="2"
                        Padding="6,4" Click="Dir_Click" Tag="top"/>
                <Button Grid.Row="1" Grid.Column="0" Content="← LEFT" Margin="2"
                        Padding="6,4" Click="Dir_Click" Tag="left"/>
                <Button Grid.Row="1" Grid.Column="2" Content="RIGHT →" Margin="2"
                        Padding="6,4" Click="Dir_Click" Tag="right"/>
                <Button Grid.Row="2" Grid.Column="1" Content="↓ BOTTOM" Margin="2"
                        Padding="6,4" Click="Dir_Click" Tag="bottom"/>
            </Grid>

            <Button x:Name="BtnSansDir" Content="Valider sans direction"
                    Margin="0,10,0,0" Padding="6,6" Click="Dir_Click" Tag=""/>
        </StackPanel>
    </Border>
</Window>
