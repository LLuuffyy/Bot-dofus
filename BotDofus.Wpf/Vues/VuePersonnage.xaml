<UserControl x:Class="BotDofus.Wpf.Vues.VuePersonnage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  Padding="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Avatar + nom + niveau -->
            <materialDesign:Card Grid.Column="0" Padding="20" Margin="0,0,16,0" VerticalAlignment="Top">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="120" Height="120">
                        <Ellipse x:Name="EllipseAvatar" Fill="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock x:Name="TxtClasseAbrev"
                                   Text="—"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="TxtNom" Text="—" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock x:Name="TxtClasse" Text="Classe / Sexe" Opacity="0.7" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtNiveau" Text="Niveau —" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <Separator Margin="0,16"/>
                    <TextBlock Text="Kamas" FontSize="11" Opacity="0.7" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtKamas" Text="0" FontSize="16" FontWeight="Bold" Foreground="#FFC107" HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Caracs -->
            <materialDesign:Card Grid.Column="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="Caractéristiques" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,4">
                            <TextBlock Text="Points de vie" Opacity="0.7" FontSize="11"/>
                            <TextBlock x:Name="TxtPv" Text="—" FontSize="16" FontWeight="Bold" Foreground="#E53935"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="Énergie" Opacity="0.7" FontSize="11"/>
                            <TextBlock x:Name="TxtEnergie" Text="—" FontSize="16" FontWeight="Bold" Foreground="#1E88E5"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="PA" Opacity="0.7" FontSize="11"/>
                            <TextBlock x:Name="TxtPa" Text="—" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="PM" Opacity="0.7" FontSize="11"/>
                            <TextBlock x:Name="TxtPm" Text="—" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="Poids" Opacity="0.7" FontSize="11"/>
                            <TextBlock x:Name="TxtPoids" Text="—" FontSize="16" FontWeight="Bold" Foreground="#43A047"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="XP %" Opacity="0.7" FontSize="11"/>
                            <TextBlock x:Name="TxtXp" Text="—" FontSize="16" FontWeight="Bold" Foreground="#FB8C00"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="Points caracs" Opacity="0.7" FontSize="11"/>
                            <TextBlock x:Name="TxtPointsCaracs" Text="—" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="Points sorts" Opacity="0.7" FontSize="11"/>
                            <TextBlock x:Name="TxtPointsSorts" Text="—" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>

                    <Separator Margin="0,16"/>
                    <TextBlock Text="Position" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtPosition" Text="Carte —" Margin="0,2"/>

                    <Separator Margin="0,16"/>
                    <TextBlock Text="Caractéristiques" FontWeight="Bold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3" Margin="0,0,0,6">
                        <StackPanel Margin="2"><TextBlock Text="Vitalité" Opacity="0.7" FontSize="11"/><TextBlock x:Name="TxtVita" Text="—" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="2"><TextBlock Text="Sagesse" Opacity="0.7" FontSize="11"/><TextBlock x:Name="TxtSag" Text="—" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="2"><TextBlock Text="Force" Opacity="0.7" FontSize="11"/><TextBlock x:Name="TxtFor" Text="—" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="2"><TextBlock Text="Intelligence" Opacity="0.7" FontSize="11"/><TextBlock x:Name="TxtInt" Text="—" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="2"><TextBlock Text="Chance" Opacity="0.7" FontSize="11"/><TextBlock x:Name="TxtCha" Text="—" FontWeight="Bold"/></StackPanel>
                        <StackPanel Margin="2"><TextBlock Text="Agilité" Opacity="0.7" FontSize="11"/><TextBlock x:Name="TxtAgi" Text="—" FontWeight="Bold"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Auto-distribuer le capital dans :" Opacity="0.7" FontSize="11" Margin="0,4,0,4"/>
                    <WrapPanel>
                        <Button Content="Vita"  Tag="10" Click="BtnAutoCarac_Click" Margin="0,0,6,6" Padding="8,3"/>
                        <Button Content="Sag"   Tag="11" Click="BtnAutoCarac_Click" Margin="0,0,6,6" Padding="8,3"/>
                        <Button Content="Force" Tag="12" Click="BtnAutoCarac_Click" Margin="0,0,6,6" Padding="8,3"/>
                        <Button Content="Intel" Tag="13" Click="BtnAutoCarac_Click" Margin="0,0,6,6" Padding="8,3"/>
                        <Button Content="Chance" Tag="14" Click="BtnAutoCarac_Click" Margin="0,0,6,6" Padding="8,3"/>
                        <Button Content="Agi"   Tag="15" Click="BtnAutoCarac_Click" Margin="0,0,6,6" Padding="8,3"/>
                        <Button Content="⬆ Monter tous les sorts" Click="BtnAutoSorts_Click" Margin="0,0,6,6" Padding="8,3"/>
                    </WrapPanel>

                    <Separator Margin="0,16"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sorts appris" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="TxtNbSorts"
                                   Text="0 sorts"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl x:Name="ListeSorts">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252836"
                                        BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,5"
                                        Margin="0,0,6,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nom}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource AccentBrushSoft}"
                                                CornerRadius="3"
                                                Padding="6,2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Niveau}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
