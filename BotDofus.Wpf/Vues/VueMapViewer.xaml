<UserControl x:Class="BotDofus.Wpf.Vues.VueMapViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="8">
            <!-- Toolbar haut : toggles -->
            <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource MaterialDesignCardBackground}">
                <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <CheckBox x:Name="ChkAfficherIds" Content="Afficher IDs cellules" Margin="0,0,16,0"
                              Checked="ChkAfficherIds_Changed" Unchecked="ChkAfficherIds_Changed"/>
                    <CheckBox x:Name="ChkAfficherEntites" Content="Afficher entités" IsChecked="True"
                              Checked="ChkAfficherIds_Changed" Unchecked="ChkAfficherIds_Changed" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkAfficherTransitions" Content="Afficher transitions" IsChecked="True"
                              Checked="ChkAfficherIds_Changed" Unchecked="ChkAfficherIds_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text=".travel" VerticalAlignment="Center" FontFamily="Consolas" Opacity="0.75" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtTravelX" Width="54" Margin="0,0,4,0" materialDesign:HintAssist.Hint="x"/>
                    <TextBox x:Name="TxtTravelY" Width="54" Margin="0,0,8,0" materialDesign:HintAssist.Hint="y"/>
                    <Button x:Name="BtnTravelCoords" Click="BtnTravelCoords_Click" Style="{StaticResource TopNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MapMarkerPath" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Travel"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </DockPanel>
            </Border>

            <!-- Position en bas -->
            <Border DockPanel.Dock="Bottom" Padding="8" Background="{DynamicResource MaterialDesignCardBackground}">
                <TextBlock x:Name="TxtPositionFooter" Text="Position : —" FontFamily="Consolas" FontSize="13"/>
            </Border>

            <!-- Canvas iso interactif -->
            <Border Background="#1A1A1A" ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="CanvasMap" Background="Transparent"
                            MouseWheel="CanvasMap_MouseWheel"
                            MouseLeftButtonDown="CanvasMap_MouseLeftButtonDown"
                            MouseRightButtonDown="CanvasMap_MouseRightButtonDown"
                            MouseRightButtonUp="CanvasMap_MouseRightButtonUp"
                            MouseMove="CanvasMap_MouseMove">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                        </Canvas.LayoutTransform>
                    </Canvas>

                    <!-- Tooltip hover -->
                    <Border x:Name="TooltipBorder" Background="#CC222222" Padding="8,4"
                            CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="8" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="TxtTooltip" Foreground="White" FontFamily="Consolas" FontSize="11"/>
                    </Border>

                    <!-- Légende -->
                    <Border Background="#CC222222" Padding="10,8" CornerRadius="4"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
                        <StackPanel>
                            <TextBlock Text="Légende" FontWeight="Bold" Foreground="White" FontSize="11" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="12" Height="12" Fill="DodgerBlue" Margin="0,0,6,0"/>
                                <TextBlock Text="Vous" Foreground="White" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="12" Height="12" Fill="LimeGreen" Margin="0,0,6,0"/>
                                <TextBlock Text="Joueur" Foreground="White" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="12" Height="12" Fill="#DC3C3C" Margin="0,0,6,0"/>
                                <TextBlock Text="Monstre" Foreground="White" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Ellipse Width="12" Height="12" Fill="#50B4DC" Margin="0,0,6,0"/>
                                <TextBlock Text="PNJ" Foreground="White" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Rectangle Width="12" Height="12" Fill="#FF9800" Margin="0,0,6,0"/>
                                <TextBlock Text="Transition" Foreground="White" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Boutons zoom -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Orientation="Horizontal">
                        <Button Click="BtnZoomIn_Click" Style="{StaticResource MaterialDesignFloatingActionMiniDarkButton}" Margin="0,0,4,0">
                            <materialDesign:PackIcon Kind="Plus"/>
                        </Button>
                        <Button Click="BtnZoomOut_Click" Style="{StaticResource MaterialDesignFloatingActionMiniDarkButton}" Margin="0,0,4,0">
                            <materialDesign:PackIcon Kind="Minus"/>
                        </Button>
                        <Button Click="BtnRecentrer_Click" Style="{StaticResource MaterialDesignFloatingActionMiniDarkButton}">
                            <materialDesign:PackIcon Kind="Target"/>
                        </Button>
                    </StackPanel>

                    <!-- Menu contextuel clic droit sur entité -->
                    <Border x:Name="MenuContextuel" Background="#FF1E1E1E" BorderBrush="#FF555555" BorderThickness="1"
                            CornerRadius="4" Padding="8" Visibility="Collapsed"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel x:Name="MenuContextuelContenu" MinWidth="240"/>
                    </Border>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Info panel droite -->
        <Border Grid.Column="1" Margin="0,8,8,8" Padding="12" Background="{DynamicResource MaterialDesignCardBackground}">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="POSITION" FontWeight="Bold" FontSize="11" Opacity="0.7"/>
                    <TextBlock x:Name="TxtMapId" Text="Carte : —" Margin="0,4,0,2"/>
                    <TextBlock x:Name="TxtCellId" Text="Cellule : —"/>
                    <TextBlock x:Name="TxtCoords" Text="(x, y) : —"/>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="ENTITÉS" FontWeight="Bold" FontSize="11" Opacity="0.7"/>
                    <ItemsControl x:Name="ListeEntites" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,2" FontSize="11" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="ACTIONS" FontWeight="Bold" FontSize="11" Opacity="0.7"/>
                    <TextBlock Text="Clic gauche cellule : déplacer" Margin="0,4,0,2" FontSize="11" Opacity="0.7"/>
                    <TextBlock Text="Clic droit entité : menu" FontSize="11" Opacity="0.7"/>
                    <TextBlock Text="Clic droit + drag : pan" FontSize="11" Opacity="0.7"/>
                    <TextBlock Text="Molette : zoom" FontSize="11" Opacity="0.7"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
