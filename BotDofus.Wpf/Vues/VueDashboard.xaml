<UserControl x:Class="BotDofus.Wpf.Vues.VueDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Alerte staff : visible uniquement si DetecteurStaff a détecté un modo -->
        <Border x:Name="BandeauAlerteStaff"
                Grid.Row="0"
                Background="#552424"
                BorderBrush="#E06C6C"
                BorderThickness="0,0,0,2"
                Padding="14,10"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠"
                           FontSize="22"
                           Foreground="#FFCD52"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MODÉRATEUR DÉTECTÉ EN LIGNE"
                               FontWeight="Bold"
                               Foreground="#FFCD52"
                               FontSize="14"/>
                    <TextBlock x:Name="TxtAlerteDetail"
                               Text="—"
                               Foreground="#FFE7AC"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bandeau résumé compact (carte / position / kamas / statut) -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelBorderStyle}"
                Padding="14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Carte" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtCarte" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Position" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtPosition" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kamas" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtKamas" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Statut" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatut" Text="—" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats de session : 6 cartes horizontales avec compteurs live. -->
        <Border Grid.Row="2"
                Style="{StaticResource PanelBorderStyle}"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="6,0">
                    <TextBlock Text="Temps online" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatTemps" Text="00:00:00" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0">
                    <TextBlock Text="Paquets ↓ / ↑" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatPaquets" Text="0 / 0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="6,0">
                    <TextBlock Text="Octets ↓ / ↑" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatOctets" Text="0 / 0" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="6,0">
                    <TextBlock Text="Combats" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatCombats" Text="0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="6,0">
                    <TextBlock Text="Kamas gagnés" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatKamas" Text="+0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#FFB300" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="6,0">
                    <TextBlock Text="XP gagnée" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatXp" Text="+0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#7BD389" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="6,0">
                    <TextBlock Text="Paquets modifiés" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatModifies" Text="0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#FF7AB8" Margin="0,4,0,0"
                               ToolTip="Paquets modifiés/supprimés par le moteur d'interception (furtivité Phase 2)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre de filtres pour la console -->
        <Border Grid.Row="3"
                Style="{StaticResource PanelBorderStyle}"
                Padding="12"
                Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Console"
                               Style="{StaticResource SectionTitleTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkInfo"     Content="Logs"          IsChecked="True"  Margin="0,0,12,0" Checked="Filtre_Toggle" Unchecked="Filtre_Toggle"/>
                    <CheckBox x:Name="ChkDebug"   Content="Debug"          IsChecked="False" Margin="0,0,12,0" Checked="Filtre_Toggle" Unchecked="Filtre_Toggle"/>
                    <CheckBox x:Name="ChkWarn"    Content="Avertissements" IsChecked="True"  Margin="0,0,12,0" Checked="Filtre_Toggle" Unchecked="Filtre_Toggle"/>
                    <CheckBox x:Name="ChkErr"     Content="Erreurs"        IsChecked="True"  Margin="0,0,18,0" Checked="Filtre_Toggle" Unchecked="Filtre_Toggle"/>
                    <TextBox x:Name="TxtRecherche"
                             Width="200"
                             materialDesign:HintAssist.Hint="Filtrer par texte / [TAG]"
                             TextChanged="TxtRecherche_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <CheckBox x:Name="ChkAutoScrollConsole"
                              Content="Auto-scroll"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"/>
                    <TextBlock x:Name="TxtCount" Text="0 lignes" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Click="BtnEffacer_Click" Style="{StaticResource TopNavButtonStyle}" Content="Effacer"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Console : TextBox readonly multi-lignes — scroll WPF natif éprouvé.
             On perd la couleur par niveau mais la fiabilité du scroll est non-négociable. -->
        <Border Grid.Row="4"
                Style="{StaticResource PanelBorderStyle}"
                Padding="0">
            <TextBox x:Name="TxtLogs"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#E0E5EC"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Visible"
                     HorizontalScrollBarVisibility="Auto"
                     PreviewMouseWheel="TxtLogs_PreviewMouseWheel"
                     Padding="6"/>
        </Border>
    </Grid>
</UserControl>
