<UserControl x:Class="BotDofus.Wpf.Vues.VueDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Alerte staff : visible uniquement si DetecteurStaff a détecté un modo -->
        <Border x:Name="BandeauAlerteStaff"
                Grid.Row="0"
                Background="#552424"
                BorderBrush="#E06C6C"
                BorderThickness="0,0,0,2"
                Padding="14,10"
                Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠"
                           FontSize="22"
                           Foreground="#FFCD52"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MODÉRATEUR DÉTECTÉ EN LIGNE"
                               FontWeight="Bold"
                               Foreground="#FFCD52"
                               FontSize="14"/>
                    <TextBlock x:Name="TxtAlerteDetail"
                               Text="—"
                               Foreground="#FFE7AC"
                               FontSize="11"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bandeau résumé compact (carte / position / kamas / statut) -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelBorderStyle}"
                Padding="14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Carte" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtCarte" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Position" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtPosition" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kamas" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtKamas" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Statut" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatut" Text="—" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats de session : 6 cartes horizontales avec compteurs live. -->
        <Border Grid.Row="2"
                Style="{StaticResource PanelBorderStyle}"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="6,0">
                    <TextBlock Text="Temps online" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatTemps" Text="00:00:00" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0">
                    <TextBlock Text="Paquets ↓ / ↑" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatPaquets" Text="0 / 0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="6,0">
                    <TextBlock Text="Octets ↓ / ↑" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatOctets" Text="0 / 0" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="6,0">
                    <TextBlock Text="Combats" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatCombats" Text="0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="6,0">
                    <TextBlock Text="Kamas gagnés" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatKamas" Text="+0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#FFB300" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="6,0">
                    <TextBlock Text="XP gagnée" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatXp" Text="+0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#7BD389" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="6,0">
                    <TextBlock Text="Paquets modifiés" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatModifies" Text="0" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#FF7AB8" Margin="0,4,0,0"
                               ToolTip="Paquets modifiés/supprimés par le moteur d'interception (furtivité Phase 2)"/>
                </StackPanel>
                <StackPanel Grid.Column="7" Margin="6,0">
                    <TextBlock Text="Anti-burst" Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="TxtStatAntiBurst" Text="OFF" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#7BD389" Margin="0,4,0,0"
                               ToolTip="Délais humains imposés aux injections autonomes (Phase 3). OFF en mode passif."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre de filtres pour la console -->
        <Border Grid.Row="3"
                Style="{StaticResource PanelBorderStyle}"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Console"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <CheckBox x:Name="ChkInfo"     Content="Logs"          IsChecked="True"  Margin="0,0,12,0" Checked="Filtre_Toggle" Unchecked="Filtre_Toggle"/>
                        <CheckBox x:Name="ChkDebug"   Content="Debug"          IsChecked="False" Margin="0,0,12,0" Checked="Filtre_Toggle" Unchecked="Filtre_Toggle"/>
                        <CheckBox x:Name="ChkWarn"    Content="Avertissements" IsChecked="True"  Margin="0,0,12,0" Checked="Filtre_Toggle" Unchecked="Filtre_Toggle"/>
                        <CheckBox x:Name="ChkErr"     Content="Erreurs"        IsChecked="True"  Margin="0,0,18,0" Checked="Filtre_Toggle" Unchecked="Filtre_Toggle"/>
                        <TextBox x:Name="TxtRecherche"
                                 Width="200"
                                 materialDesign:HintAssist.Hint="Filtrer par texte / [TAG]"
                                 TextChanged="TxtRecherche_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <CheckBox x:Name="ChkAutoScrollConsole"
                                  Content="Auto-scroll"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0"/>
                        <TextBlock x:Name="TxtCount" Text="0 lignes" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Click="BtnEffacer_Click" Style="{StaticResource TopNavButtonStyle}" Content="Effacer"/>
                    </StackPanel>
                </DockPanel>

                <!-- Ligne 2 : filtres par CATÉGORIE (chips colorés par couleur
                     d'accent MoonBot). Décocher Réseau coupe tout le bruit
                     [REENC]/[VOCAB]/[OBS] etc. Visuel : Foreground = couleur
                     de la catégorie pour identification instantanée. -->
                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Catégories :"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkCatAction"   Content="Action"     IsChecked="True"  Foreground="#5CE08A" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatRecolte"  Content="Récolte"    IsChecked="True"  Foreground="#7BD389" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatTrajet"   Content="Trajet"     IsChecked="True"  Foreground="#4FC3F7" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatInv"      Content="Inventaire" IsChecked="True"  Foreground="#FFCA61" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatBanque"   Content="Banque"     IsChecked="True"  Foreground="#FFD988" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatCmd"      Content="Commandes"  IsChecked="True"  Foreground="#D0A2FF" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatScript"   Content="Script"     IsChecked="True"  Foreground="#B388FF" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatCombat"   Content="Combat"     IsChecked="True"  Foreground="#FF7B7B" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatBot"      Content="Bot"        IsChecked="True"  Foreground="#FF8A65" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatAuth"     Content="Auth"       IsChecked="True"  Foreground="#5C9DFF" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatServer"   Content="Server"     IsChecked="True"  Foreground="#BCAAA4" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatNetwork"  Content="Network"    IsChecked="True"  Foreground="#7986CB" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatGame"     Content="Game"       IsChecked="True"  Foreground="#26D07C" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatQuete"    Content="Quête"      IsChecked="True"  Foreground="#FFE57F" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatImportant" Content="Important" IsChecked="True"  Foreground="#FFD54F" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatReseau"   Content="Réseau"     IsChecked="False" Foreground="#9AA5B0" FontWeight="SemiBold" Margin="0,0,10,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <CheckBox x:Name="ChkCatJeu"      Content="Jeu"        IsChecked="True"  Foreground="#A9B4BD" FontWeight="SemiBold" Margin="0,0,18,4" Checked="FiltreCat_Toggle" Unchecked="FiltreCat_Toggle"/>
                    <Button Click="BtnCatTout_Click"   Style="{StaticResource TopNavButtonStyle}" Content="Tout"    Margin="0,0,6,0"/>
                    <Button Click="BtnCatAucun_Click"  Style="{StaticResource TopNavButtonStyle}" Content="Aucun"   Margin="0,0,6,0"/>
                    <Button Click="BtnCatScenario_Click" Style="{StaticResource TopNavButtonStyle}" Content="Scénario" ToolTip="Action + Récolte + Trajet + Important : la 'story' du bot, masque le debug"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Console colorée (style MoonBot) : ListBox VIRTUALISÉE → scroll
             ScrollViewer natif fiable + perf à 5000 lignes, couleur par
             catégorie via binding (CategorieLog). Remplace l'ancien TextBox
             (couleur impossible) + supprime le hack molette LineUp/LineDown. -->
        <Border Grid.Row="4"
                Style="{StaticResource PanelBorderStyle}"
                Padding="0">
            <ListBox x:Name="TxtLogs"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#E0E5EC"
                     FontFamily="Consolas"
                     FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     Padding="6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1,0,0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Heure}"
                                       Foreground="#5A6472"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CategorieNom}"
                                       Foreground="{Binding Pinceau}"
                                       FontWeight="SemiBold"
                                       Width="74"/>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding Pinceau}"
                                       TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
