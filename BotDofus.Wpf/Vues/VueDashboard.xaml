<UserControl x:Class="BotDofus.Wpf.Vues.VueDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="12">
        <StackPanel>
            <TextBlock Text="Vue generale"
                       Style="{StaticResource SectionTitleTextStyle}"
                       Margin="0,0,0,12"/>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Carte" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="TxtCarte" Text="-" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,10,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Position" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="TxtPosition" Text="-" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorderStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Kamas" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="TxtKamas" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Statut de connexion" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtStatut" Text="Deconnecte" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Combat" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtCombatEtat" Text="Hors combat" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="TxtCombatTour" Text="" Foreground="{DynamicResource FaintTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
