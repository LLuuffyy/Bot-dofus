<UserControl x:Class="BotDofus.Wpf.Vues.VueDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer Padding="20">
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <materialDesign:Card Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Carte" Opacity="0.7"/>
                        <TextBlock x:Name="TxtCarte" Text="—" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Position" Opacity="0.7"/>
                        <TextBlock x:Name="TxtPosition" Text="—" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Padding="16" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Kamas" Opacity="0.7"/>
                        <TextBlock x:Name="TxtKamas" Text="0" FontSize="20" FontWeight="Bold"
                                   Foreground="#FFC107"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <materialDesign:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Statut connexion" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtStatut" Text="Déconnecté" Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="Combat" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtCombatEtat" Text="Hors combat" Opacity="0.7"/>
                    <TextBlock x:Name="TxtCombatTour" Text="" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
