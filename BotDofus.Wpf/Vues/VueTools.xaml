<UserControl x:Class="BotDofus.Wpf.Vues.VueTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <Border Style="{StaticResource PanelBorderStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ACCES DIRECT"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">
                        <Button Click="BtnTravelBanque_Click" Style="{StaticResource TopNavButtonStyle}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BankOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Banque"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnTravelHdv_Click" Style="{StaticResource TopNavButtonStyle}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StorefrontOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="HDV"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnBestiaire_Click" Style="{StaticResource TopNavButtonStyle}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookSearchOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Bestiaire"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTravelX" Grid.Column="0" Margin="0,0,8,0" materialDesign:HintAssist.Hint="x"/>
                        <TextBox x:Name="TxtTravelY" Grid.Column="1" Margin="0,0,8,0" materialDesign:HintAssist.Hint="y"/>
                        <Button Grid.Column="2" Click="BtnTravelCustom_Click" Style="{StaticResource AccentNavButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="MapMarkerPath" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="Envoyer .travel"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="TxtDerniereAction"
                               Text="Pret"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CHAT / COMMANDES"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbCanal" Grid.Column="0" Margin="0,0,8,0" SelectedIndex="0">
                            <ComboBoxItem Content="*" ToolTip="Général"/>
                            <ComboBoxItem Content="#" ToolTip="Recrutement"/>
                            <ComboBoxItem Content="$" ToolTip="Commerce"/>
                            <ComboBoxItem Content="^" ToolTip="Privé"/>
                            <ComboBoxItem Content="%" ToolTip="Groupe"/>
                            <ComboBoxItem Content="&amp;" ToolTip="Guilde"/>
                        </ComboBox>
                        <TextBox x:Name="TxtChat"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 KeyDown="TxtChat_KeyDown"
                                 materialDesign:HintAssist.Hint="Message ou commande (.pos, .who...)"/>
                        <Button Grid.Column="2" Click="BtnEnvoyerChat_Click" Style="{StaticResource AccentNavButtonStyle}">
                            <materialDesign:PackIcon Kind="SendOutline" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    <UniformGrid Columns="4" Margin="0,8,0,0">
                        <Button Click="BtnQuickPos_Click" Style="{StaticResource TopNavButtonStyle}" Margin="0,0,4,0" ToolTip="Affiche la position courante">
                            <TextBlock Text=".pos" FontFamily="Consolas"/>
                        </Button>
                        <Button Click="BtnQuickWho_Click" Style="{StaticResource TopNavButtonStyle}" Margin="0,0,4,0" ToolTip="Liste les joueurs sur la map">
                            <TextBlock Text=".who" FontFamily="Consolas"/>
                        </Button>
                        <Button Click="BtnQuickStaff_Click" Style="{StaticResource TopNavButtonStyle}" Margin="0,0,4,0" ToolTip="Liste les modérateurs en ligne">
                            <TextBlock Text=".staff" FontFamily="Consolas"/>
                        </Button>
                        <Button Click="BtnQuickHelp_Click" Style="{StaticResource TopNavButtonStyle}" ToolTip="Aide commandes Hystoria">
                            <TextBlock Text=".help" FontFamily="Consolas"/>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="PAQUET BRUT"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,12"/>
                    <TextBox x:Name="TxtPaquetBrut"
                             FontFamily="Consolas"
                             materialDesign:HintAssist.Hint="Ex: DB123456 ou cC+i"/>
                    <Button Click="BtnEnvoyerPaquet_Click"
                            Style="{StaticResource TopNavButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SendOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Envoyer au serveur"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="BESTIAIRE"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,12"/>
                    <TextBox x:Name="TxtBestiaire"
                             materialDesign:HintAssist.Hint="Rechercher un monstre par nom ou ID"
                             TextChanged="TxtBestiaire_TextChanged"/>
                    <ListBox x:Name="LstBestiaire"
                             MaxHeight="180"
                             Margin="0,8,0,0"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource BorderSoftBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorderStyle}" Padding="14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="INTERCEPTION (PHASE 2)" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ChkInterceptActif"
                                  Content="Actif"
                                  IsChecked="True"
                                  Checked="ChkInterceptActif_Toggle"
                                  Unchecked="ChkInterceptActif_Toggle"
                                  ToolTip="Kill-switch global de l'interception"/>
                    </Grid>
                    <TextBlock Text="Modif inline du flux client réel = furtif (timing/keep-alive officiels)."
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>

                    <UniformGrid Columns="2">
                        <Button Click="BtnPresetObserve_Click" Style="{StaticResource TopNavButtonStyle}" Margin="0,0,4,4"
                                ToolTip="Logge tous les paquets de jeu (G*) sans rien modifier">
                            <TextBlock Text="Observer G*"/>
                        </Button>
                        <Button Click="BtnPresetDropPing_Click" Style="{StaticResource TopNavButtonStyle}" Margin="4,0,0,4"
                                ToolTip="Exemple : supprime un préfixe au choix">
                            <TextBlock Text="Drop préfixe"/>
                        </Button>
                        <Button Click="BtnInterceptVider_Click" Style="{StaticResource TopNavButtonStyle}" Margin="0,4,4,0"
                                ToolTip="Retire toutes les règles">
                            <TextBlock Text="Tout vider"/>
                        </Button>
                        <Button Click="BtnInterceptRafraichir_Click" Style="{StaticResource TopNavButtonStyle}" Margin="4,4,0,0">
                            <TextBlock Text="Rafraîchir"/>
                        </Button>
                    </UniformGrid>

                    <ListBox x:Name="LstRegles"
                             MaxHeight="140"
                             Margin="0,10,0,0"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource BorderSoftBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DIAGNOSTIC SYSTEME" Style="{StaticResource SectionTitleTextStyle}"/>
                        <Button Grid.Column="1" Click="BtnDiagnostic_Click" Style="{StaticResource TopNavButtonStyle}" Padding="8,4">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    <ItemsControl x:Name="ListeDiagnostic">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icone}" FontFamily="Consolas" FontSize="14" Foreground="{Binding Couleur}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Libelle}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <Button Click="BtnInstallerHosts_Click"
                                Style="{StaticResource TopNavButtonStyle}"
                                Margin="0,0,4,4"
                                ToolTip="Injecte &lt;connexionServers&gt; dans config.xml Aqua (force le client à se connecter à 127.0.0.1:7781). Normalement fait automatiquement par Lancer jeu.">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Patcher config.xml"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnRetirerHosts_Click"
                                Style="{StaticResource TopNavButtonStyle}"
                                Margin="4,0,0,4"
                                ToolTip="Retire tout résidu &lt;connexionServers&gt; du config.xml Aqua (utile si le bot a crashé).">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Nettoyer config.xml"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ENTITES DE LA MAP" Style="{StaticResource SectionTitleTextStyle}"/>
                            <Button Grid.Column="1" Click="BtnRafraichir_Click" Style="{StaticResource TopNavButtonStyle}" Padding="8,4">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                    </Border>

                <ListBox x:Name="LstOutils" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titre}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="BtnCopierId_Click" Tag="{Binding}" Style="{StaticResource TopNavButtonStyle}" Padding="8,4" Margin="0,0,6,0">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14"/>
                                        </Button>
                                        <Button Click="BtnOuvrirEntite_Click" Tag="{Binding}" Style="{StaticResource AccentNavButtonStyle}" Padding="8,4">
                                            <materialDesign:PackIcon Kind="LoginVariant" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
