<Window x:Class="BotDofus.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BotDofus.Wpf"
        xmlns:vues="clr-namespace:BotDofus.Wpf.Vues"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Bot Dofus Hystoria — v0.2"
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             SIDEBAR : liste des comptes (style SynFus)
             ============================================================ -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignToolBarBackground}">
            <DockPanel>
                <!-- Header sidebar -->
                <Border DockPanel.Dock="Top" Padding="16" Background="{DynamicResource PrimaryHueDarkBrush}">
                    <StackPanel>
                        <TextBlock Text="Bot Dofus" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                        <TextBlock Text="Hystoria · v0.2" FontSize="11" Opacity="0.7"
                                   Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Boutons d'action -->
                <Border DockPanel.Dock="Top" Padding="12">
                    <StackPanel>
                        <Button x:Name="BtnAjouterCompte" Click="BtnAjouterCompte_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                                <TextBlock Text="Ajouter un compte"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDemarrerTous" Click="BtnDemarrerTous_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Margin="0,0,8,0"/>
                                <TextBlock Text="Démarrer tous"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Liste des comptes (binding sur ViewModel) -->
                <ListBox x:Name="LstComptes" SelectionChanged="LstComptes_SelectionChanged"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,2" CornerRadius="4">
                                <DockPanel>
                                    <!-- Avatar (placeholder cercle coloré) -->
                                    <Ellipse Width="40" Height="40" Margin="0,0,12,0"
                                             Fill="{Binding StatusBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Identifiant}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StatusTexte}" FontSize="11" Opacity="0.7"/>
                                        <TextBlock Text="{Binding NomPerso}" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================
             ZONE PRINCIPALE : header info perso + onglets
             ============================================================ -->
        <DockPanel Grid.Column="1">
            <!-- Header info perso (HP/Énergie/XP/Poids) -->
            <Border DockPanel.Dock="Top" Padding="20,12" Background="{DynamicResource MaterialDesignCardBackground}">
                <Grid x:Name="HeaderPerso">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar + nom + niveau -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse Width="48" Height="48" Fill="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNomPerso" Text="—" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtClassePerso" Text="Aucun perso connecté" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Stats : HP/Énergie/XP/Poids (barres) -->
                    <UniformGrid Grid.Column="1" Columns="4" Margin="32,0">
                        <StackPanel Margin="8,0">
                            <TextBlock Text="VIE" FontSize="10" Opacity="0.7"/>
                            <ProgressBar x:Name="BarVie" Maximum="100" Value="0" Height="14"
                                         Foreground="#E53935" Background="#3D1010"/>
                            <TextBlock x:Name="TxtVie" Text="0 / 0" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="8,0">
                            <TextBlock Text="ÉNERGIE" FontSize="10" Opacity="0.7"/>
                            <ProgressBar x:Name="BarEnergie" Maximum="100" Value="0" Height="14"
                                         Foreground="#1E88E5" Background="#0D2538"/>
                            <TextBlock x:Name="TxtEnergie" Text="0 / 0" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="8,0">
                            <TextBlock Text="XP" FontSize="10" Opacity="0.7"/>
                            <ProgressBar x:Name="BarXp" Maximum="100" Value="0" Height="14"
                                         Foreground="#FB8C00" Background="#3D2510"/>
                            <TextBlock x:Name="TxtXp" Text="0 %" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="8,0">
                            <TextBlock Text="POIDS" FontSize="10" Opacity="0.7"/>
                            <ProgressBar x:Name="BarPoids" Maximum="100" Value="0" Height="14"
                                         Foreground="#43A047" Background="#102D14"/>
                            <TextBlock x:Name="TxtPoids" Text="0 / 0" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Boutons d'action perso -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnConnecter" Click="BtnConnecter_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Power" Margin="0,0,4,0"/>
                                <TextBlock Text="Connecter"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDeconnecter" Click="BtnDeconnecter_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4,0">
                            <materialDesign:PackIcon Kind="Stop"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Onglets de navigation -->
            <TabControl x:Name="TabsContent" TabStripPlacement="Top" Margin="0">
                <TabItem Header="Dashboard">
                    <vues:VueDashboard x:Name="VueDash"/>
                </TabItem>
                <TabItem Header="Personnage">
                    <vues:VuePersonnage x:Name="VuePersoTab"/>
                </TabItem>
                <TabItem Header="Carte">
                    <vues:VueMapViewer x:Name="VueMap"/>
                </TabItem>
                <TabItem Header="Inventaire">
                    <vues:VueInventaire x:Name="VueInvTab"/>
                </TabItem>
                <TabItem Header="Combat">
                    <vues:VueCombat x:Name="VueCombatTab"/>
                </TabItem>
                <TabItem Header="Scripts">
                    <vues:VueScripts x:Name="VueScriptsTab"/>
                </TabItem>
                <TabItem Header="Sniffer">
                    <vues:VueSniffer x:Name="VueSnif"/>
                </TabItem>
                <TabItem Header="Config">
                    <vues:VueConfig x:Name="VueConfigTab"/>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
