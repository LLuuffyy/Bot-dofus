<Application x:Class="BotDofus.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark"
                                             PrimaryColor="BlueGrey"
                                             SecondaryColor="Teal" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101114" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#1F2127" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#292C33" />
            <SolidColorBrush x:Key="SurfaceBrushAlt" Color="#30343D" />
            <SolidColorBrush x:Key="SurfaceBrushSoft" Color="#262930" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#262830" />
            <SolidColorBrush x:Key="SidebarBrushAlt" Color="#22242B" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="#393D47" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#4A4F5B" />
            <SolidColorBrush x:Key="AccentBrush" Color="#6C76FF" />
            <SolidColorBrush x:Key="AccentBrushSoft" Color="#424AA5" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#65C56F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#D7BA5B" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C95761" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA0AC" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="#7C818B" />

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
                <Setter Property="Foreground" Value="#F2F4F8" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#ECEFF5" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </Style>

            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrushSoft}" />
                <Setter Property="Foreground" Value="#F2F4F8" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
                <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource FaintTextBrush}" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource SurfaceBrushSoft}" />
                <Setter Property="Foreground" Value="#F2F4F8" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="10" />
                <Setter Property="Background" Value="#181A1F" />
            </Style>

            <Style x:Key="TopNavButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Background" Value="{StaticResource SurfaceBrushSoft}" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#00000000" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavRoot" Property="Background" Value="{StaticResource SurfaceBrushAlt}" />
                                    <Setter Property="Foreground" Value="#F3F5FA" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentNavButtonStyle" TargetType="Button" BasedOn="{StaticResource TopNavButtonStyle}">
                <Setter Property="Background" Value="#2E3156" />
                <Setter Property="Foreground" Value="#C9CEFF" />
                <Setter Property="BorderBrush" Value="#444D9F" />
            </Style>

            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#00000000"
                                    BorderThickness="0,0,0,2"
                                    CornerRadius="8,8,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabRoot" Property="Background" Value="#2C2F38" />
                                    <Setter Property="Foreground" Value="#EFF2FA" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabRoot" Property="Background" Value="#2A2D35" />
                                    <Setter TargetName="TabRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemRoot"
                                    Background="Transparent"
                                    BorderBrush="#00000000"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemRoot" Property="Background" Value="#313541" />
                                    <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#414654" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemRoot" Property="Background" Value="#2F3450" />
                                    <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#4953A9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="RowBackground" Value="#2A2D35" />
                <Setter Property="AlternatingRowBackground" Value="#262930" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#353944" />
                <Setter Property="VerticalGridLinesBrush" Value="#00000000" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#EEF1F7" />
                <Setter Property="HeadersVisibility" Value="Column" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#31343D" />
                <Setter Property="Foreground" Value="#AEB4C0" />
                <Setter Property="BorderBrush" Value="#31343D" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Height" Value="36" />
            </Style>

            <!-- Scrollbar plus visible que la défaut WPF (très fine, presque invisible en dark theme).
                 14px de large + couleurs contrastées pour qu'on la voie tout de suite. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="#1B1D22" />
                <Setter Property="Foreground" Value="#5A6172" />
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="14" />
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="14" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Thumb" x:Key="ScrollThumbStyle">
                <Setter Property="Background" Value="#5A6172" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
