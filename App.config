<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Serveur Aqua (Dofus Retro 1.39.6, play-astra.net) -->
    <!-- Auth : IP statique observée par DLL hook aqua_hook.log (REDIRECT 141.94.99.2:7781) -->
    <add key="ServeurAuth.Hote" value="141.94.99.2" />
    <add key="ServeurAuth.Port" value="7781" />

    <!-- Jeu : transmis dynamiquement dans le paquet AYK (hostname aqua.play-astra.net:5562) -->
    <add key="ServeurJeu.Hote" value="aqua.play-astra.net" />
    <add key="ServeurJeu.Port" value="5562" />

    <!-- Le proxy MITM écoute sur deux ports locaux : un par étape de la session.
         Le client lit l'IP via config.xml (PatcheurConfigXml), donc le port auth local
         DOIT correspondre à celui qu'on patche dans le <connserver port=...>. -->
    <add key="Proxy.PortAuthLocal" value="7781" />
    <add key="Proxy.PortJeuLocal" value="5562" />

    <!-- Compat avec l'ancien nom de clef -->
    <add key="Proxy.PortLocal" value="7781" />

    <add key="Journalisation.Niveau" value="Info" />
    <add key="Journalisation.DossierSortie" value="logs" />
  </appSettings>
</configuration>
