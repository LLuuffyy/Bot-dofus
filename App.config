<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Serveur Abrak (abrak.fr, Dofus Retro) — TCP BRUT, pas de TLS -->
    <!-- Auth : 51.89.153.20:1303 (HC challenge confirmé via capture netstat live) -->
    <add key="ServeurAuth.Hote" value="51.89.153.20" />
    <add key="ServeurAuth.Port" value="1303" />

    <!-- Jeu : même IP, port +1 (post-AYK) -->
    <add key="ServeurJeu.Hote" value="51.89.153.20" />
    <add key="ServeurJeu.Port" value="1304" />

    <!-- Le proxy MITM écoute sur deux ports locaux : un par étape de la session.
         Le client lit l'IP via config.xml (PatcheurConfigXml), donc le port auth local
         DOIT correspondre à celui qu'on patche dans le <connserver port=...>. -->
    <add key="Proxy.PortAuthLocal" value="1303" />
    <add key="Proxy.PortJeuLocal" value="1304" />

    <!-- Compat avec l'ancien nom de clef -->
    <add key="Proxy.PortLocal" value="1303" />

    <add key="Journalisation.Niveau" value="Info" />
    <add key="Journalisation.DossierSortie" value="logs" />
  </appSettings>
</configuration>
