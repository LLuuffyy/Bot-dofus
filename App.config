<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- DEPRECATED 2026-06 :
         Toutes les valeurs serveur (IP, ports, nom, chemin client) sont désormais
         centralisées dans Commun/Reseau/ConfigReseau.cs et persistées dans
         config-reseau.json (à côté de l'exe).
         Ce fichier ne sert plus que pour la journalisation. -->

    <add key="Journalisation.Niveau" value="Info" />
    <add key="Journalisation.DossierSortie" value="logs" />
  </appSettings>
</configuration>
